{
  "name": "kie-ai-mcp",
  "version": "0.4.0",
  "description": "Higgsfield-style image, video, and voice creation in Claude, ChatGPT/Codex, Cursor, VS Code, and Windsurf using flexible KIE credits.",
  "type": "module",
  "license": "MIT",
  "author": "alfman99",
  "homepage": "https://github.com/alfman99/kie-ai-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfman99/kie-ai-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alfman99/kie-ai-mcp/issues"
  },
  "keywords": [
    "kie",
    "kie-ai",
    "mcp",
    "model-context-protocol",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "ai-media",
    "claude",
    "chatgpt",
    "cursor",
    "codex",
    "vscode",
    "github-copilot",
    "windsurf"
  ],
  "bin": {
    "kie-ai-mcp": "dist/src/index.js",
    "kie-ai-docs": "dist/scripts/kie-docs.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    ".agents/skills/kie-ai"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "node dist/scripts/smoke.js",
    "smoke:dev": "tsx scripts/smoke.ts",
    "mcp:doctor": "node dist/scripts/mcp-doctor.js",
    "mcp:doctor:live": "node dist/scripts/mcp-doctor.js --live",
    "bundle:claude": "npm run build && node scripts/build-mcpb.mjs",
    "docs:check": "tsx scripts/kie-docs.ts check",
    "docs:update": "tsx scripts/kie-docs.ts update",
    "bundle:claude:info": "npx --yes @anthropic-ai/mcpb@2.1.2 info release/kie-ai-mcp.mcpb"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
