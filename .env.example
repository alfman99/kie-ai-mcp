# Copy to .env for local Docker Compose smoke checks, or pass directly with:
# docker run --rm -i -e KIE_API_KEY=your-kie-api-key kie-ai-mcp-server
KIE_API_KEY=your-kie-api-key

# Optional defaults
KIE_API_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_POLL_INTERVAL_MS=5000
KIE_POLL_TIMEOUT_MS=600000
KIE_ALLOW_LOCAL_FILE_UPLOADS=false

# Optional reviewed external catalog snapshot. Omit to use the bundled snapshot.
KIE_DOCS_DATA_DIR=

# Optional, only needed for webhook verification when not passing the key to the tool.
KIE_WEBHOOK_HMAC_KEY=
