# Developer-only environment template for local source checks.
KIE_API_KEY=your-kie-api-key

# Optional defaults
KIE_API_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
# Steady status-poll cadence. The first checks ramp up to it, so short jobs return sooner.
KIE_POLL_INTERVAL_MS=2500
KIE_POLL_TIMEOUT_MS=600000
# Delay before the first status re-check.
KIE_POLL_FIRST_DELAY_MS=600
# Ceiling the cadence eases toward once a render is clearly long-running.
KIE_POLL_MAX_INTERVAL_MS=8000
# Elapsed wait time after which the cadence starts easing toward the ceiling.
KIE_POLL_EASE_AFTER_MS=90000
# Per-request deadline, so one stalled socket cannot consume a whole wait budget.
KIE_REQUEST_TIMEOUT_MS=20000
# Ceiling on simultaneous in-flight KIE requests across all parallel jobs.
KIE_MAX_CONCURRENT_REQUESTS=8

# Tool surface. "standard" exposes the curated set; "full" adds advanced escape-hatch tools.
KIE_TOOL_PROFILE=standard
# How long an idempotencyKey can replay its original submission instead of paying again.
KIE_SUBMISSION_TTL_MS=1800000
# How long a finished task result is served from memory instead of the network.
KIE_RESULT_CACHE_TTL_MS=1800000
# Open the API connection at startup so the first call skips the TLS handshake.
KIE_PREWARM_CONNECTION=true
KIE_ALLOW_LOCAL_FILE_UPLOADS=false
# Required when local uploads are enabled. Use one folder containing only media intended for KIE.
KIE_LOCAL_UPLOAD_ROOT=

# Optional reviewed external catalog snapshot. Omit to use the bundled snapshot.
KIE_DOCS_DATA_DIR=

# Optional, only needed for webhook verification when not passing the key to the tool.
KIE_WEBHOOK_HMAC_KEY=
